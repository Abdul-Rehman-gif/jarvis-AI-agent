# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Security hardening additions ---
# JARVIS_API_KEY: required in the x-jarvis-api-key header on every /api/*
# request (chat UI included). If unset, a random one is generated each
# startup and printed to the console - set it here to keep it stable.
JARVIS_API_KEY="generate-a-long-random-value-here"

# JARVIS_PAIRING_CODE: shared secret the Python desktop agent must present
# to authenticate over the WebSocket bridge. Must match on both sides.
JARVIS_PAIRING_CODE="generate-a-long-random-value-here"

# JARVIS_HOST: network interface the server binds to. Defaults to
# 127.0.0.1 (localhost only). Only set to 0.0.0.0 if you know what you're
# doing and have auth/TLS handled in front of this.
JARVIS_HOST="127.0.0.1"

# JARVIS_PORT: defaults to 3000.
JARVIS_PORT="3000"

# JARVIS_ALLOW_POWER_ACTIONS: set to "1" ON THE AGENT MACHINE to allow
# remote shutdown/restart commands. Unset/anything else blocks them.
JARVIS_ALLOW_POWER_ACTIONS="0"

# WEATHER_DEFAULT_CITY: used when you ask for the weather without naming a
# city. Uses Open-Meteo (free, no API key needed).
WEATHER_DEFAULT_CITY="Lahore, Pakistan"
